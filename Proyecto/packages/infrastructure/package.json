    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "@cotizapp/shared-config": "workspace:*",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.9.2",
    "vitest": "^3.0.0"
  }
}
