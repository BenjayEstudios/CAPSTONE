# Modo de ejecucion de Node
NODE_ENV=development
# Entorno logico de la app (dev/stg/prd)
ENVIRONMENT=dev


# Nombre de la app (usado en logs/healthchecks)
APP_NAME=capstone-api
# Version de la app
APP_VERSION=1.0.0
# Host donde escucha el server (duplica HOST mas abajo)
APP_HOST=localhost
# Puerto donde escucha el server (duplica PORT mas abajo)
APP_PORT=8000
# Nivel de verbosidad de logs
LOG_LEVEL=debug
# Formato de logs (json para produccion)
LOG_FORMAT=pretty
# Timeout maximo por request, en ms
REQUEST_TIMEOUT_MS=30000
# Habilita el endpoint de healthcheck
ENABLE_HEALTHCHECKS=true
# Ruta del endpoint de healthcheck
HEALTHCHECK_PATH=/health-check
# Tiempo de espera antes de forzar el cierre del server, en ms
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000




# Origenes permitidos por CORS (lista separada por coma)
CORS_ORIGINS=http://localhost:5173, http://localhost:4200,http://localhost:5174
# Metodos HTTP permitidos por CORS
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
# Activa headers de seguridad HTTP (tipo helmet)
SECURITY_HEADERS=true
# Backend usado para rate limiting
RATE_LIMIT_PROVIDER=redis
# Cantidad maxima de requests permitidas por ventana
RATE_LIMIT_MAX=100
# Duracion de la ventana de rate limiting, en ms
RATE_LIMIT_WINDOW_MS=60000



# Tamano maximo del body de una request (bytes)
FASTIFY_BODY_LIMIT=1048576
# Confia en headers de proxy (X-Forwarded-*), util detras de nginx/load balancer
FASTIFY_TRUST_PROXY=false
# Activa compresion de respuestas (gzip/brotli)
COMPRESSION_ENABLED=true



# Issuer esperado en los JWT (vacio: sin validar)
AUTH_ISSUER=
# Audience esperada en los JWT (vacio: sin validar)
AUTH_AUDIENCE=
# Secreto para firmar JWT de acceso (dev: cualquier valor sirve, no se usa en prod)
JWT_SECRET=dev-secret-not-for-prod
# Secreto para firmar JWT de refresh (dev: cualquier valor sirve, no se usa en prod)
JWT_REFRESH_SECRET=dev-refresh-secret-not-for-prod
# Duracion del JWT de acceso
JWT_EXPIRATION=15m
# Duracion del JWT de refresh
JWT_REFRESH_EXPIRATION=30d
# Secreto para firmar sesion/cookies (dev: cualquier valor sirve, no se usa en prod)
SESSION_SECRET=dev-session-secret-not-for-prod
# Costo de hashing de contrasenas (bcrypt/argon)
PASSWORD_HASH_ROUNDS=12




# SSL para conexion a MySQL (NO se usa en el codigo actual: createDbClient/mysql.createPool solo lee DATABASE_URL, ver packages/infrastructure/src/db/client.ts)
MYSQL_SSL=false
# URL de conexion a la base de datos MySQL (cotizapp). Unica variable de DB que lee el codigo (apps/rest/src/config/env.ts -> packages/infrastructure/src/db/client.ts).
# Apunta al MySQL local levantado con `docker compose up -d mysql` (ver docker-compose.yml). Si corres el backend tambien dentro de docker compose, DATABASE_URL se sobreescribe ahi mismo apuntando a mysql:3306 (nombre del servicio) en vez de localhost.
DATABASE_URL=mysql://cotizapp:cotizapp@localhost:3306/cotizapp
# --- Variables de DB desglosadas (informativas / uso de proveedores tipo PlanetScale, Aiven, RDS, etc.) ---
# NO se leen en el codigo actual: solo se usa DATABASE_URL. Se listan para referencia de infraestructura/ops o por si el proveedor de BD las pide por separado.
# Nombre de la base de datos
DB_NAME=cotizapp
# Host del servidor de base de datos
DB_HOST=localhost

# Puerto del servidor de base de datos
DB_PORT=3306
# Usuario de conexion a la base de datos
DB_USER=cotizapp
# Password del usuario de base de datos
DB_PASSWORD=cotizapp
# Modo SSL de la conexion (disable | require | verify-ca | verify-full, segun el proveedor)
DB_SSL_MODE=disable
# Certificado CA para validar la conexion SSL con la BD (ruta o contenido PEM, si el proveedor lo exige)
DB_CA_CERT=


# URL de conexion a Redis (PENDIENTE: vacia, no hay Redis local configurado todavia)
REDIS_URL=
# Habilita TLS en la conexion a Redis
REDIS_TLS_ENABLED=false
# Indice de base de datos de Redis
REDIS_DB=0
# Prefijo/namespace de las keys de cache
CACHE_NAMESPACE=api-cache-dev
# Tiempo de vida de las entradas de cache, en segundos
CACHE_TTL_SECONDS=3600



# API key de Resend para envio de correos (PENDIENTE: vacia)
RESEND_API_KEY=
# Direccion remitente de los correos enviados
EMAIL_FROM=


# Cantidad de items por pagina por defecto en listados
PAGINATION_DEFAULT_LIMIT=20
# Cantidad maxima de items por pagina permitida
PAGINATION_MAX_LIMIT=100
# Tamano maximo de archivos subidos, en MB
FILE_UPLOAD_MAX_MB=25
# Tipos MIME permitidos para archivos subidos
ALLOWED_MIME_TYPES=image/png,image/jpeg,application/pdf

# Puerto del server (duplica APP_PORT de arriba)
PORT=8000
# Host del server (duplica APP_HOST de arriba). Esta es la variable que realmente lee apps/rest/src/config/env.ts
HOST=localhost

# Origen permitido por CORS, singular (duplica/choca con CORS_ORIGINS de arriba)
CORS_ORIGIN=http://localhost:4200
