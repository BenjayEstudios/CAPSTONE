# Flutter no lee .env de forma nativa: estas variables se inyectan en tiempo de
# compilacion con
#   flutter run --dart-define-from-file=.env
# y se leen en Dart en lib/core/config/app_config.dart (AppConfig).

# URL base de la API REST (apps/backend). Si se deja vacia, la app usa
# http://10.0.2.2:8000 en Android y http://localhost:8000 en el resto.
# - Emulador Android: http://10.0.2.2:8000 (10.0.2.2 = localhost del host)
# - Simulador iOS / desktop / web: http://localhost:8000
# - Dispositivo fisico: http://<IP de tu maquina en la red local>:8000
API_URL=http://10.0.2.2:8000

# true: los repositorios usan datasources fake con los datos del seed
# (packages/infrastructure/src/db/seed), sin necesidad de backend.
# false: todo va contra API_URL. Lo que la API debe exponer esta en
# API_CONTRACT.md.
USE_FAKES=true
