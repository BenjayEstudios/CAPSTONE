# Flutter no lee .env de forma nativa: estas variables se inyectan en tiempo de
# compilacion con
#   flutter run --dart-define-from-file=.env
# y se leen en Dart con const String.fromEnvironment("API_URL").
# (Todavia no hay codigo que lo lea: ApiClient en lib/core/network/api_client.dart
# recibe baseUrl, pero nadie lo instancia aun.)

# URL base de la API REST (apps/backend).
# - Emulador Android: http://10.0.2.2:8000 (10.0.2.2 = localhost del host)
# - Simulador iOS / desktop: http://localhost:8000
# - Dispositivo fisico: http://<IP de tu maquina en la red local>:8000
API_URL=http://10.0.2.2:8000
