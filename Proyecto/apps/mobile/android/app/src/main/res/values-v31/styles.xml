<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ dibuja su propio splash con el ícono (adaptativo, ver
         mipmap-anydpi-v26) sobre este fondo tinta, para que pase sin saltos
         al SplashPage de Flutter. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/tinta</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
