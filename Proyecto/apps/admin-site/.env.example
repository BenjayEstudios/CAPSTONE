# OJO: este archivo actualmente no lo lee Angular (no hay soporte nativo de
# .env). La config real del frontend vive en
# src/environments/environment.ts (produccion) y
# environment.development.ts (desarrollo). Estas variables quedan como
# referencia/documentacion para cuando se conecte algun mecanismo que si
# las lea (ver README.md -> Variables de entorno).

# URL base de la API REST (backend), version v1.
API_URL=http://localhost:8000/api/v1

# Credencial del cliente para autenticarse contra la API (PENDIENTE: sigue en valor de ejemplo)
API_KEY=replace-me
# Flujo OAuth2 usado para obtener el token (client_credentials: machine-to-machine)
GRANT_TYPE=client_credentials
