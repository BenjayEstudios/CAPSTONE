# Variables que interpola infra/docker-compose.prod.yml (${MYSQL_PASSWORD},
# ${MYSQL_ROOT_PASSWORD}). Docker Compose lee automaticamente el .env que esta
# junto al docker-compose.prod.yml, asi que este archivo va en infra/.env.
# La config del backend NO va aca: va en apps/backend/.env (env_file del servicio rest).

# Password del usuario "cotizapp" de MySQL. Debe coincidir con el password de
# DATABASE_URL en apps/backend/.env (mysql://cotizapp:<este valor>@mysql:3306/cotizapp)
MYSQL_PASSWORD=change-me
# Password del usuario root de MySQL (solo para administracion, la app no lo usa)
MYSQL_ROOT_PASSWORD=change-me-root
