# Variables de producción que interpola infra/docker-compose.prod.yml.
# Docker Compose lee automáticamente el .env que está junto al compose, así
# que en el droplet este archivo se copia a infra/.env (nunca se versiona).
# apps/backend/.env NO se usa en producción: es solo para desarrollo.
#
# Generar secretos con:  openssl rand -hex 32

# Dominio del ecommerce y subdominio del panel admin-site (sin http://).
# Sin dominio propio todavía: usar nip.io sobre la IP del droplet, que
# resuelve cualquier subdominio a esa IP sin configurar DNS, ej.:
#   APP_DOMAIN=203.0.113.10.nip.io
#   ADMIN_DOMAIN=admin.203.0.113.10.nip.io
APP_DOMAIN=cotizapp.example.cl
ADMIN_DOMAIN=admin.cotizapp.example.cl

# Puertos publicados en el host (80/443 en el droplet; otros para pruebas locales).
HTTP_PORT=80
HTTPS_PORT=443

# http | https (KAN-159). Pasar a https DESPUÉS de emitir el certificado con
# infra/deploy/certificado.sh; los dominios deben ser propios (no nip.io).
PUBLIC_SCHEME=http
# Correo para los avisos de Let's Encrypt (certificado por vencer). Opcional.
LETSENCRYPT_EMAIL=

# Tamaño máximo de un archivo subido, en MB (entero). Lo usan el backend
# (rechaza con 413) y Nginx (tope del body = este valor + 1 MB).
UPLOADS_MAX_MB=5

# Password del usuario "cotizapp" de MySQL. SOLO caracteres alfanuméricos:
# el compose lo inserta en DATABASE_URL (mysql://cotizapp:<pass>@mysql:3306/...).
MYSQL_PASSWORD=change-me
# Password del usuario root de MySQL (administración y respaldos; la app no lo usa).
MYSQL_ROOT_PASSWORD=change-me-root

# Secreto para firmar los JWT del backend.
JWT_SECRET=change-me-jwt
