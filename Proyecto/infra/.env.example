# Variables de producción que interpola infra/docker-compose.prod.yml.
# Docker Compose lee automáticamente el .env que está junto al compose, así
# que en el droplet este archivo se copia a infra/.env (nunca se versiona).
# apps/backend/.env NO se usa en producción: es solo para desarrollo.
#
# Generar secretos con:  openssl rand -hex 32

# Dominio del ecommerce (sin http://). Sin dominio todavía: la IP del droplet.
APP_DOMAIN=cotizapp.example.cl

# Puerto HTTP publicado en el host (80 en el droplet; otro para pruebas locales).
HTTP_PORT=80

# Password del usuario "cotizapp" de MySQL. SOLO caracteres alfanuméricos:
# el compose lo inserta en DATABASE_URL (mysql://cotizapp:<pass>@mysql:3306/...).
MYSQL_PASSWORD=change-me
# Password del usuario root de MySQL (administración y respaldos; la app no lo usa).
MYSQL_ROOT_PASSWORD=change-me-root

# Secreto para firmar los JWT del backend.
JWT_SECRET=change-me-jwt
