# Plantilla de Nginx en modo HTTPS (PUBLIC_SCHEME=https y certificado
# presente, KAN-159). La elige entrypoint/18-esquema.envsh.
# Variables: ${APP_DOMAIN}, ${ADMIN_DOMAIN} y ${NGINX_BODY_MAX_MB}.

include /etc/nginx/snippets/comun.conf;

# Tope del body de cualquier request (subidas de archivos incluidas).
client_max_body_size ${NGINX_BODY_MAX_MB}m;

# Puerto 80: solo el desafío de Let's Encrypt (renovaciones) y redirección
# permanente a HTTPS de todo lo demás.
server {
    listen 80 default_server;
    server_name _;
    include /etc/nginx/snippets/acme.conf;
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${APP_DOMAIN};
    include /etc/nginx/snippets/tls.conf;
    include /etc/nginx/snippets/sitio-ecommerce.conf;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${ADMIN_DOMAIN};
    include /etc/nginx/snippets/tls.conf;
    include /etc/nginx/snippets/sitio-admin.conf;
}
